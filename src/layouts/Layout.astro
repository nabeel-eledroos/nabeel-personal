---
import { ViewTransitions } from 'astro:transitions';
import TopBar from '../components/TopBar.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/base.css';

interface Props {
  title?: string;
  showBack?: boolean;
  activeNav?: string;
}

const { title = 'Nabeel Eledroos', showBack = false, activeNav } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <ViewTransitions />
  </head>
  <body>
    <TopBar showBack={showBack} activeNav={activeNav} />
    <main class="wrap">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>

<style>
  main {
    padding-bottom: 80px;
  }
</style>
