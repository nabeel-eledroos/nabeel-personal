---
import Layout from '../../layouts/Layout.astro';
import InteriorHeader from '../../components/InteriorHeader.astro';
import PageFooter from '../../components/PageFooter.astro';
import Lightbox from '../../components/Lightbox.astro';
import photoData from '../../content/photography.json';

const allImages = import.meta.glob<{ default: ImageMetadata }>('../../assets/photography-assets/**/*.{jpg,png,jpeg}', { eager: true });

export function getStaticPaths() {
  return photoData.map((album) => ({
    params: { slug: album.id },
    props: { album },
  }));
}

const { album } = Astro.props;

const albumImages = Object.entries(allImages)
  .filter(([path]) => path.includes(`/${album.assetFolder}/`))
  .map(([path, module]) => ({
    src: module.default.src,
    filename: path.split('/').pop() || '',
    width: module.default.width,
    height: module.default.height,
    aspectRatio: module.default.width / module.default.height,
  }));
---

<Layout title={`${album.title} — Photography`} showBack={true} activeNav="photography">
  <InteriorHeader
    titleHighlight={album.title}
    subLine1={album.place}
    subLine2={`${albumImages.length} photos · ${album.year}`}
  />

  {album.summary && <p class="lead animate-rise animate-rise-2">{album.summary}</p>}

  <div class="ms">
    {albumImages.map((img, i) => (
      <img 
        class="ms-item animate-rise" 
        src={img.src} 
        alt={img.filename}
        loading={i < 6 ? "eager" : "lazy"}
        style={`animation-delay: ${0.14 + i * 0.06}s;`}
        data-index={i}
      />
    ))}
  </div>

  <PageFooter count={album.title} backHref="/photography" backLabel="collections" />

  <Lightbox />
</Layout>

<style>
  .lead {
    font-size: 18px;
    color: var(--brown);
    max-width: 62ch;
    line-height: 1.6;
    margin: 10px 0 28px;
  }

  .ms {
    column-count: 3;
    column-gap: 14px;
  }

  .ms-item {
    width: 100%;
    break-inside: avoid;
    margin-bottom: 14px;
    border-radius: 3px;
    cursor: zoom-in;
    transition: transform 0.15s ease;
  }

  .ms-item:hover {
    transform: scale(0.985);
  }

  @media (max-width: 760px) {
    .ms {
      column-count: 2;
    }
  }
</style>

<script>
  const items = document.querySelectorAll('.ms-item');
  const images = Array.from(items).map((item) => {
    const img = item as HTMLImageElement;
    return {
      src: img.src,
      caption: document.querySelector('h1 .hl')?.textContent || 'Photo',
    };
  });

  items.forEach((item, index) => {
    item.addEventListener('click', () => {
      if ((window as any).openLightbox) {
        (window as any).openLightbox(images, index);
      }
    });
  });
</script>
