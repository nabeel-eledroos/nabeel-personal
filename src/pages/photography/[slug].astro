---
import Layout from '../../layouts/Layout.astro';
import InteriorHeader from '../../components/InteriorHeader.astro';
import PageFooter from '../../components/PageFooter.astro';
import Lightbox from '../../components/Lightbox.astro';

const allImages = import.meta.glob<{ default: ImageMetadata }>('../../assets/photography-assets/**/*.{jpg,png,jpeg}', { eager: true });

export function getStaticPaths() {
  const albums = ['paris-london', 'summer-2025'];
  return albums.map(slug => ({ params: { slug } }));
}

const { slug } = Astro.params;

const albumImages = Object.entries(allImages)
  .filter(([path]) => path.includes(`/${slug}/`))
  .map(([path, module]) => ({
    src: module.default.src,
    filename: path.split('/').pop() || '',
    width: module.default.width,
    height: module.default.height,
    isLandscape: module.default.width > module.default.height,
  }));

const albumTitles: Record<string, string> = {
  'paris-london': 'Paris & London',
  'summer-2025': 'Summer 2025',
};

const albumYears: Record<string, string> = {
  'paris-london': '2022',
  'summer-2025': '2025',
};
---

<Layout title={`${albumTitles[slug] || slug} — Photography`} showBack={true} activeNav="photography">
  <InteriorHeader
    titleHighlight={albumTitles[slug] || slug}
    subLine1="photo album"
    subLine2={albumYears[slug] || '2024'}
  />

  <div class="photo-grid">
    {albumImages.map((img, i) => (
      <div 
        class={`photo-item ${img.isLandscape ? 'landscape' : ''} animate-rise`}
        style={`animation-delay: ${0.14 + i * 0.06}s;`}
        data-index={i}
      >
        <img src={img.src} alt={img.filename} loading="lazy" />
      </div>
    ))}
  </div>

  <PageFooter count={`${albumImages.length} frames`} backHref="/photography" backLabel="all photography" />

  <Lightbox />
</Layout>

<style>
  .photo-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-top: 24px;
  }

  .photo-item {
    cursor: zoom-in;
    overflow: hidden;
    border-radius: 8px;
    transition: transform 0.16s ease;
  }

  .photo-item.landscape {
    grid-column: 1 / -1;
  }

  .photo-item:hover {
    transform: scale(0.99);
  }

  .photo-item img {
    width: 100%;
    height: auto;
    display: block;
  }

  @media (max-width: 760px) {
    .photo-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 420px) {
    .photo-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const items = document.querySelectorAll('.photo-item');
  const images = Array.from(items).map((item, i) => {
    const img = item.querySelector('img');
    return {
      src: img?.src || '',
      caption: `Photo ${i + 1}`,
    };
  });

  items.forEach((item, i) => {
    item.addEventListener('click', () => {
      if ((window as any).openLightbox) {
        (window as any).openLightbox(images, i);
      }
    });
  });
</script>
